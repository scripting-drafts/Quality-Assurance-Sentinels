{
  "endpoint": "http://127.0.0.1:8088/ingest",
  "token_env": "QA_SIEM_TOKEN",
  "token_file": "/etc/qa-siem/token",
  "batch_size": 200,
  "timeout_s": 15,
  "lookback_hours": 24,
  "types": [
    "findings",
    "events",
    "crashes",
    "boots",
    "hardware",
    "lsm",
    "tickets"
  ],
  "verify_tls": true,
  "ca_file": ""
}
